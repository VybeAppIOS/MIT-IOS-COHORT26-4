          "stringUnit" : {
            "state" : "translated",
            "value" : "More"
          }
        }
      }
    },
    "hangoutDetail.notFound" : {
      "comment" : "Shown when the Hangout was removed or never existed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Hangout is no longer available."
          }
        }
      }
    },
    "hangoutDetail.offline" : {
      "comment" : "Under the disabled Start button while offline.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're offline. Connect to start this Hangout."
          }
        }
      }
    },
    "hangoutDetail.otherHangoutLive" : {
      "comment" : "Under the disabled Start button while another Hangout is live.",
