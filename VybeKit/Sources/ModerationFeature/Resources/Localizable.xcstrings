    "moderation.block.body" : {
      "comment" : "What blocking does.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They won't be able to see your posts or message you, and you won't see theirs. They won't be told."
          }
